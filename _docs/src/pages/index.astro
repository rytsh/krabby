---
import "@fontsource/rakkas/latin-400.css";
import "@fontsource/shantell-sans/latin-700.css";
import "@fontsource/shantell-sans/latin-700-italic.css";
import "@fontsource/shantell-sans/latin-800-italic.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-700.css";
import "../styles/global.css";

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const plate = (name: string) => `${base}plates/${name}.webp`;
const repo = "https://github.com/rytsh/krabby";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>krabby · every answer, charted to the line</title>
    <meta
      name="description"
      content="Krabby is a self-hosted Go binary that indexes your repositories and other sources, builds a knowledge graph per repo, and serves code search, docs and graph analysis to AI agents over MCP."
    />
    <meta name="theme-color" content="#efe6cf" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="krabby" />
    <meta
      property="og:description"
      content="Self-hosted. One Go binary. Graph-backed references with exact path:line, served to your agent over MCP."
    />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="page">
        <div class="mast-row">
          <p class="ear ear-left">Code indexes<br />better <span class="ul">together</span></p>
          <a class="wordmark" href="#top" aria-label="krabby home">
            <img src={`${base}krabby.webp`} alt="krabby" width="800" height="313" />
          </a>
          <p class="ear ear-right">A more<br />knowledgeable<br /><span class="ul">tomorrow!</span></p>
        </div>
        <nav class="rule" aria-label="Primary">
          <span class="dateline">Self-hosted · MIT · Built for agents</span>
          <ul>
            <li><a href="#how">How it works</a></li>
            <li><a href="#features">Features</a></li>
            <li><a href="#quickstart">Quick start</a></li>
            <li><a href={`${repo}/blob/main/DETAILS.md#mcp-tools`}>MCP tools</a></li>
            <li><a href={repo}>GitHub</a></li>
          </ul>
          <span class="dateline">Code · Docs · People · All connected</span>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="splash-wrap" id="top" aria-labelledby="hero-title">
        <div class="page">
          <div class="panel splash">
            <div class="caption hero-caption">
              <h1 id="hero-title">Every answer, <span class="ul">charted to the line.</span></h1>
              <p>
                Self-hosted. One Go binary. Graph-backed references with exact <code>path:line</code>, across repos,
                Confluence, Jira, Slack and more, served to your agent over MCP.
              </p>
            </div>

            <div class="agent">
              <img class="robot" src={plate("robot")} alt="" width="1346" height="1145" />
              <p class="bubble">
                Where is payment retry backoff implemented?
                <svg class="tail" viewBox="0 0 40 36" aria-hidden="true">
                  <polygon points="10,-6 34,-6 34,0 4,34 10,0" />
                  <polyline points="10,0 4,34 34,0" />
                </svg>
              </p>
            </div>

            <figure class="lens">
              <img
                src={plate("detective")}
                alt="The krabby crab detective holds a magnifier over line 42 of retry.go: func retryWithBackoff."
                width="1400"
                height="982"
              />
              <svg class="arrows" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                <path d="M38 47 C40 52, 43 55, 45 60" />
                <path d="M84 53 C78 55, 72 57, 66 60" />
              </svg>
              <span class="chip chip-a">worker.go:57</span>
              <span class="chip chip-b">charge.go:118</span>
            </figure>

            <div class="sources">
              <p class="caption tiny">Across your codebase and beyond…</p>
              <img src={plate("sources-sign")} alt="" width="1399" height="958" />
            </div>

            <div class="graph-side">
              <p class="caption tiny">…krabby builds a knowledge graph so your agent can find the real thing.</p>
              <img src={plate("graph")} alt="" width="1400" height="950" />
            </div>

            <p class="scrawl">Exact path:line.<br /><span class="ul">Real context.</span></p>

            <div class="coupon" id="run">
              <p class="coupon-head">
                <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="6" r="3" /><circle cx="6" cy="18" r="3" /><path d="M20 4 8.1 15.9M14.5 14.5 20 20M8.1 8.1 12 12" /></svg>
                Clip &amp; run krabby today!
              </p>
              <div class="cmd">
                <pre id="cmd-hero">docker run -d -p 8080:8080 \
  -v "$(pwd)/krabby-data:/data" \
  ghcr.io/rytsh/krabby:latest</pre>
                <button class="copy" type="button" data-copy="cmd-hero">Copy</button>
              </div>
              <div class="coupon-actions">
                <a class="btn btn-red" href="#quickstart">Quick start <span aria-hidden="true">→</span></a>
                <a class="btn" href={repo}>
                  <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" /></svg>
                  GitHub
                </a>
              </div>
              <p class="coupon-note">One binary. Any source. <span class="ul">AI-ready.</span></p>
            </div>
          </div>
        </div>
      </section>

      <section id="how" aria-labelledby="how-title">
        <div class="page strip">
          <h2 id="how-title" class="strip-title">How it <span class="ul">works</span></h2>
          <ol class="strip-panels">
            <li class="panel">
              <h3 class="caption tiny">1. Index</h3>
              <img src={plate("step1-art")} alt="" width="1400" height="480" loading="lazy" />
              <p>Clone your repositories and pull in web pages, Confluence, Jira and other sources. Indexes refresh in the background.</p>
            </li>
            <li class="panel">
              <h3 class="caption tiny">2. Build graph</h3>
              <img src={plate("step2-art")} alt="" width="1400" height="751" loading="lazy" />
              <p>An AST-based extractor builds a knowledge graph per repo. No LLM key needed.</p>
            </li>
            <li class="panel">
              <h3 class="caption tiny">3. Serve to agents</h3>
              <img src={plate("step3-art")} alt="" width="1400" height="920" loading="lazy" />
              <p>Code search, docs and graph analysis go out over MCP, split into read-only, API and admin catalogs.</p>
            </li>
            <li class="panel">
              <h3 class="caption tiny">4. Get real answers</h3>
              <img src={plate("step4-art")} alt="" width="1400" height="950" loading="lazy" />
              <p>Your agent cites real paths and lines instead of pasting the whole repo into its context.</p>
            </li>
          </ol>
        </div>
      </section>

      <section id="case" aria-labelledby="case-title">
        <div class="page">
          <header class="section-head">
            <h2 id="case-title">The case of the <span class="ul">retry backoff</span></h2>
            <p>Three tool calls from a question to cited evidence. The repository is already indexed; no model or embedder is needed for this flow.</p>
          </header>

          <ol class="case">
            <li class="panel case-panel">
              <p class="caption tiny">First, locate it</p>
              <p>Ranked source search, scoped to one repo so similarly named code elsewhere stays out of the answer.</p>
              <code>search_code &#123; repo: "github.com/acme/payments", query: "payment retry backoff" &#125;</code>
              <p class="balloon">Found it: <b>internal/payment/retry.go:42</b></p>
            </li>
            <li class="panel case-panel">
              <p class="caption tiny">Then, prove who calls it</p>
              <p>References are real graph edges. The <code class="inline">call</code> context leaves out imports, field types and name collisions.</p>
              <code>find_references &#123; repo: "github.com/acme/payments", symbol: "retryWithBackoff", context: ["call"] &#125;</code>
              <p class="balloon">Two callers: <b>charge.go:118</b>, <b>worker.go:57</b></p>
            </li>
            <li class="panel case-panel">
              <p class="caption tiny">Finally, read only the evidence</p>
              <p>Open the file around the reported line and answer with paths your team can check.</p>
              <code>read_file &#123; repo: "github.com/acme/payments", path: "internal/payment/retry.go" &#125;</code>
              <p class="balloon">Case closed, with sources.</p>
            </li>
          </ol>
          <p class="footnote">Example repository and paths are illustrative.</p>
        </div>
      </section>

      <section id="features" aria-labelledby="features-title">
        <div class="page">
          <header class="section-head">
            <h2 id="features-title">In this <span class="ul">issue</span></h2>
            <p>What krabby hands your agent, column by column.</p>
          </header>

          <div class="columns">
            <article>
              <h3>Graph queries, in-process</h3>
              <p>A native Go engine reads <code class="inline">graph.json</code> directly and hot-reloads on rebuild. No subprocess per graph.</p>
              <p class="tools">query_graph · get_node · shortest_path</p>
            </article>
            <article>
              <h3>Symbols, not guesses</h3>
              <p>A definition is a node with a path and a line. A reference is a real incoming edge you can filter by context.</p>
              <p class="tools">find_definition · find_references · glob</p>
            </article>
            <article>
              <h3>Regex with exact hits</h3>
              <p>A byte-trigram index answers RE2 patterns with file, line and column. Add a code embedder and the same chunks serve semantic search.</p>
              <p class="tools">search_code · mode: regex | semantic</p>
            </article>
            <article>
              <h3>Docs beside the code</h3>
              <p>With an LLM configured, krabby writes per-file Markdown docs and a repo overview. Web pages, Confluence and Jira are indexed next to them.</p>
              <p class="tools">search_docs · list_sources · repo_overview</p>
            </article>
            <article>
              <h3>History on call</h3>
              <p>Tags, commits, diffs and blame are one call away, so an agent can explain when and why a line changed.</p>
              <p class="tools">git_log · git_diff · git_blame</p>
            </article>
            <article>
              <h3>Plain files on disk</h3>
              <p>Clones, graphs, reports and vectors live under <code class="inline">~/.krabby</code>. Other tools can read them too.</p>
              <p class="tools">bw · BadgerDB · /webhook/git</p>
            </article>
          </div>
        </div>
      </section>

      <section id="quickstart" aria-labelledby="qs-title">
        <div class="page">
          <header class="section-head">
            <h2 id="qs-title">Clip &amp; <span class="ul">save</span></h2>
            <p>Start the container, add a repository in the UI, then hand your agent the read-only catalog.</p>
          </header>

          <div class="qs">
            <div class="coupon coupon-lg">
              <p class="coupon-head">Step 1 · Run it</p>
              <div class="cmd">
                <pre id="cmd-docker">mkdir -p krabby-data

docker run -d \
  --name krabby \
  -p 8080:8080 \
  -v "$(pwd)/krabby-data:/data" \
  ghcr.io/rytsh/krabby:latest</pre>
                <button class="copy" type="button" data-copy="cmd-docker">Copy</button>
              </div>
              <ol class="next">
                <li>Open <a href="http://localhost:8080">localhost:8080</a>.</li>
                <li>Add a public repository, or store a host credential first for a private one.</li>
                <li>Wait for <b>Ready</b>: clone, graph and source index run in the background.</li>
              </ol>
            </div>

            <div class="coupon coupon-lg">
              <p class="coupon-head">Step 2 · Connect your agent</p>
              <div class="cmd">
                <pre id="cmd-mcp">&#123;
  "mcp": &#123;
    "krabby": &#123;
      "type": "remote",
      "url": "http://localhost:8080/mcp"
    &#125;,
    "krabby-admin": &#123;
      "type": "remote",
      "url": "http://localhost:8080/mcp/admin",
      "enabled": false
    &#125;
  &#125;
&#125;</pre>
                <button class="copy" type="button" data-copy="cmd-mcp">Copy</button>
              </div>
              <p class="coupon-note">OpenCode <code class="inline">opencode.json</code>. Any MCP client works.</p>
            </div>
          </div>

          <ul class="catalogs">
            <li><code>/mcp</code><b>Everyday code work.</b> Read-only code, graph, files, history and docs. Keep it on.</li>
            <li><code>/mcp/api</code><b>Live API work.</b> Discovers catalogued endpoints and can call them. Enable when needed.</li>
            <li><code>/mcp/admin</code><b>Setup and changes.</b> Adds, refreshes or deletes resources. Turn it off for analysis.</li>
          </ul>
        </div>
      </section>
    </main>

    <footer>
      <div class="page foot">
        <img src={`${base}krabby.webp`} alt="krabby" width="800" height="313" loading="lazy" />
        <ul>
          <li><a href={repo}>GitHub</a></li>
          <li><a href={`${repo}/blob/main/DETAILS.md#mcp-tools`}>MCP tools</a></li>
          <li><a href={`${repo}/blob/main/DETAILS.md#rest-api`}>REST API</a></li>
          <li><a href="https://github.com/rytsh/bag">bag</a></li>
        </ul>
        <small>MIT © 2026 Eray Ates</small>
      </div>
    </footer>

    <script>
      document.querySelectorAll<HTMLButtonElement>(".copy").forEach((button) => {
        button.addEventListener("click", async () => {
          const target = document.getElementById(button.dataset.copy || "");
          if (!target) return;
          try {
            await navigator.clipboard.writeText(target.innerText.trim());
            button.textContent = "Copied!";
          } catch {
            button.textContent = "Select & copy";
          }
          button.classList.add("ok");
          setTimeout(() => {
            button.textContent = "Copy";
            button.classList.remove("ok");
          }, 1600);
        });
      });

      const lens = document.querySelector<HTMLElement>(".lens");
      if (lens && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        requestAnimationFrame(() => lens.classList.add("found"));
      }
    </script>
  </body>
</html>
