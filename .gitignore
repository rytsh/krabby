bin/
# Anchored to the repo root on purpose: a bare `dist/` also matches
# internal/server/dist/, and git never descends into an excluded directory, so
# the `!internal/server/dist/.gitkeep` negation below would silently do nothing.
/dist/
krabby.yaml
krabby.toml
.env
.env.local

# Web UI build artifacts. internal/server/dist is generated by `make build-ui` and
# embedded at build time; keep a placeholder so the go:embed always has
# something to embed.
_ui/node_modules/
internal/server/dist/*
!internal/server/dist/.gitkeep
